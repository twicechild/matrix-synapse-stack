# Logging configuration for Synapse.
#
# IMPORTANT: this file must exist and be writable by the Synapse container user
# (UID/GID 991 by default). If `log_config` in homeserver.yaml points to a file
# that does not exist, Synapse falls back to its built-in default, which tries
# to write /homeserver.log at the CONTAINER ROOT — as a non-root user that
# fails with `PermissionError: [Errno 13] Permission denied: '/homeserver.log'`
# and the container crash-loops. chmod 777 on the host folders will NOT fix it.
#
# The `generate` step creates this file automatically; only create it by hand
# if you are assembling the config manually.
version: 1

formatters:
    precise:
        format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
    console:
        class: logging.StreamHandler
        formatter: precise

loggers:
    # This is just here so we can leave `loggers` in the config regardless of whether
    # we configure other loggers below (avoid empty yaml dict error).
    _placeholder:
        level: "INFO"

    synapse.storage.SQL:
        # beware: increasing this to DEBUG will make synapse log sensitive
        # information such as access tokens.
        level: INFO

root:
    level: INFO
    handlers: [console]

disable_existing_loggers: false